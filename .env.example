# Environment configuration for SentinelScan SaaS

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate_a_secure_random_32_character_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_EMAIL_VERIFICATION=true

# Database Configuration
POSTGRES_USER=sentinel_prod
POSTGRES_PASSWORD=super_secure_postgres_password_here
POSTGRES_DB=sentinelscan_prod
DATABASE_URL=postgresql+asyncpg://sentinel_prod:super_secure_postgres_password_here@postgres:5432/sentinelscan_prod

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Frontend Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Single-origin production wiring (recommended):
#   Nginx serves BOTH the frontend AND /api/* on the SAME public origin, so
#   NEXT_PUBLIC_API_URL and NEXT_PUBLIC_APP_URL should resolve to the frontend
#   public origin (e.g. https://sentinelscan.io). NO wildcard CORS is used and
#   cookies stay same-site. Change these to your real deployment domain.
NEXT_PUBLIC_API_URL=https://sentinelscan.io
NEXT_PUBLIC_APP_URL=https://sentinelscan.io
NEXT_PUBLIC_APP_NAME=SentinelScan
# FRONTEND_URL must equal NEXT_PUBLIC_APP_URL (the frontend public origin). It is
# used by the backend for OAuth redirects, email links and the CORS allowlist.
FRONTEND_URL=https://sentinelscan.io

# Email / SMTP Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
SMTP_FROM=security@sentinelscan.io
SMTP_FROM_NAME=SentinelScan

# Google OAuth (optional — enables "Continue with Google")
# Production redirect URI must match the backend's public origin:
#   https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sentinelscan.io/api/auth/google/callback

# ── AI Assistant — Ask Sentinel ───────────────────────────────────────────
AI_PROVIDER=gemini
AI_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_GEMINI_MODEL=models/gemini-3.6-flash
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_CONVERSATION_TURNS=10
AI_RATE_LIMIT_PER_HOUR=20
AI_REQUEST_TIMEOUT_SECONDS=30
