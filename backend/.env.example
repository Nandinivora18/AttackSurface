DATABASE_URL=postgresql+asyncpg://sentinelscan:sentinelscan_pass@localhost:5432/sentinelscan
SYNC_DATABASE_URL=postgresql://sentinelscan:sentinelscan_pass@localhost:5432/sentinelscan

SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH 2.0 (optional — enables "Continue with Google" login/signup)
# ──────────────────────────────────────────────────────────────────────────────
# SETUP STEPS:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (or select an existing one)
#   3. Navigate to: APIs & Services → Credentials → Create Credentials → OAuth Client ID
#   4. Application type: Web application
#   5. Add Authorized redirect URIs:
#        Development: http://localhost:8000/api/auth/google/callback
#        Production:  https://<YOUR-API-DOMAIN>/api/auth/google/callback
#   6. Copy the Client ID and Client Secret below
#
# SECURITY:
#   - NEVER commit real credentials to version control
#   - GOOGLE_CLIENT_SECRET must remain backend-only — never expose to the frontend
#   - Leave blank to disable Google OAuth (the button will return an error page)
#
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@sentinelscan.io
SMTP_FROM_NAME=SentinelScan

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

ENVIRONMENT=development
DEBUG=true
REQUIRE_EMAIL_VERIFICATION=true
# DEV bypass allows login without SMTP email verification in local development ONLY.
# HARD-FORBIDDEN in production (config validator fails fast).
DEV_BYPASS_EMAIL_VERIFICATION=true

RATE_LIMIT_SCANS_PER_HOUR=10
RATE_LIMIT_AUTH_PER_MINUTE=5
MAX_ACTIVE_SCANS_PER_USER=2

MAX_SCAN_TIMEOUT=600

# CVE / NVD Integration (optional but recommended)
# Without API key: 5 requests/30s rate limit
# With API key:   50 requests/30s rate limit
# Get a free key at: https://nvd.nist.gov/developers/request-an-API-key
# NVD_API_KEY=your-nvd-api-key-here

# ── AI Assistant — Ask Sentinel (optional) ──────────────────────────────────
# Default provider "gemini" (free tier). Set AI_GEMINI_API_KEY to enable.
# Alternative: AI_PROVIDER=openai with AI_OPENAI_API_KEY (+ optional AI_OPENAI_BASE_URL).
# With no provider key configured, Ask Sentinel returns 503 and scanning continues.
AI_PROVIDER=gemini
AI_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_GEMINI_MODEL=models/gemini-3.6-flash
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_CONVERSATION_TURNS=10
AI_MAX_INPUT_MESSAGE_CHARS=4000
AI_RATE_LIMIT_PER_HOUR=20
AI_REQUEST_TIMEOUT_SECONDS=30
